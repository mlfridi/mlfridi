SIO_LLM_PROVIDER=anthropic
SIO_MODEL_TRIAGE=claude-haiku-5-5
SIO_MODEL_ANALYSIS=claude-opus-5-5
SIO_BUDGET_MONTHLY_USD=8
SIO_BUDGET_OPUS_CUTOFF_PCT=90
SIO_LANGS=fr,ar,en
SIO_TIMEZONE=Africa/Casablanca
SIO_BRIEFING_TIME=07:00
